{
  "name": "web-nav",
  "displayName": "网站导航",
  "description": "在 VS Code 侧边栏管理常用网站，在编辑器里直接打开",
  "version": "0.0.1",
  "publisher": "manaster",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MailKiller/vscode-web-nav.git"
  },
  "bugs": {
    "url": "https://github.com/MailKiller/vscode-web-nav/issues"
  },
  "homepage": "https://github.com/MailKiller/vscode-web-nav#readme",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "网站导航",
    "书签",
    "bookmark",
    "website",
    "navigation",
    "webview"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "网站导航",
      "properties": {
        "webNav.sites": {
          "type": "array",
          "default": [],
          "description": "我的网站列表",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "webNav.showRecommended": {
          "type": "boolean",
          "default": true,
          "description": "在侧边栏显示“推荐”分组"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "webNav",
          "title": "网站导航",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "webNav": [
        {
          "id": "webNav.sites",
          "name": "网站"
        }
      ]
    },
    "commands": [
      {
        "command": "webNav.open",
        "title": "打开网站",
        "category": "网站导航"
      },
      {
        "command": "webNav.addSite",
        "title": "添加网站",
        "category": "网站导航",
        "icon": "$(add)"
      },
      {
        "command": "webNav.refresh",
        "title": "刷新",
        "category": "网站导航",
        "icon": "$(refresh)"
      },
      {
        "command": "webNav.openInBrowser",
        "title": "在浏览器中打开",
        "category": "网站导航"
      },
      {
        "command": "webNav.copyUrl",
        "title": "复制链接",
        "category": "网站导航"
      },
      {
        "command": "webNav.rename",
        "title": "重命名",
        "category": "网站导航"
      },
      {
        "command": "webNav.editUrl",
        "title": "修改网址",
        "category": "网站导航"
      },
      {
        "command": "webNav.remove",
        "title": "移除",
        "category": "网站导航"
      },
      {
        "command": "webNav.addRecommended",
        "title": "添加到我的网站",
        "category": "网站导航"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "webNav.open",
          "when": "false"
        },
        {
          "command": "webNav.openInBrowser",
          "when": "false"
        },
        {
          "command": "webNav.copyUrl",
          "when": "false"
        },
        {
          "command": "webNav.rename",
          "when": "false"
        },
        {
          "command": "webNav.editUrl",
          "when": "false"
        },
        {
          "command": "webNav.remove",
          "when": "false"
        },
        {
          "command": "webNav.addRecommended",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "webNav.addSite",
          "when": "view == webNav.sites",
          "group": "navigation"
        },
        {
          "command": "webNav.refresh",
          "when": "view == webNav.sites",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "webNav.openInBrowser",
          "when": "viewItem == site.mine",
          "group": "1_open"
        },
        {
          "command": "webNav.copyUrl",
          "when": "viewItem == site.mine",
          "group": "1_open"
        },
        {
          "command": "webNav.rename",
          "when": "viewItem == site.mine",
          "group": "2_edit"
        },
        {
          "command": "webNav.editUrl",
          "when": "viewItem == site.mine",
          "group": "2_edit"
        },
        {
          "command": "webNav.remove",
          "when": "viewItem == site.mine",
          "group": "3_remove"
        },
        {
          "command": "webNav.openInBrowser",
          "when": "viewItem == site.recommended",
          "group": "1_open"
        },
        {
          "command": "webNav.addRecommended",
          "when": "viewItem == site.recommended",
          "group": "2_add"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "verify:recommended": "npm run compile-tests && node scripts/verify-recommended.js"
  },
  "devDependencies": {
    "@types/vscode": "~1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
